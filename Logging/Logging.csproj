<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Logging</PackageId>
    <Version>1.2.1</Version>
    <Authors>Tomas Lundqvist</Authors>
    <Company></Company>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference
        Include="Serilog"
        Version="4.3.0" />
    <PackageReference
        Include="Serilog.Sinks.Console"
        Version="6.0.0" />
    <PackageReference
        Include="Serilog.Sinks.Debug"
        Version="3.0.0" />
    <PackageReference
        Include="Serilog.Sinks.File"
        Version="7.0.0" />
  </ItemGroup>

  <!-- Endast None, med rätt case och Pack=true -->
  <ItemGroup>
    <None
        Include="Data\**\*.*"
        Pack="true"
        PackagePath="contentFiles\any\any\data"
        PackageCopyToOutput="true"
        CopyToOutputDirectory="PreserveNewest" />

    <None
        Include="Resources\**\*.*"
        Pack="true"
        PackagePath="contentFiles\any\any\resources"
        PackageCopyToOutput="true"
        CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None
        Include="buildTransitive\Logging.targets"
        Pack="true"
        PackagePath="buildTransitive\Logging.targets" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Readme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>